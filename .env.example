# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.
# Per-environment overrides can go in .env.qa, .env.staging or .env.prod (also git-ignored).
# Real environment variables (shell / CI secrets) always win over these files.

# Target environment: qa | staging | prod
TEST_ENV=qa

# Optional: override the environment's base URL (e.g. a local ParaBank in Docker)
# BASE_URL=http://localhost:8080

# Existing user for login and Account Services tests
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Base username/password for registration tests (a timestamp is appended for new users)
PARABANK_REGISTER_USERNAME=john123
PARABANK_REGISTER_PASSWORD=
